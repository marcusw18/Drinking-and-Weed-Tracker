[Unit]
Description=Vulture ML Server
After=network.target

[Service]
Type=simple
User=vulture
WorkingDirectory=/home/vulture/vulture-server
Environment="PATH=/home/vulture/vulture-server/venv/bin"
ExecStart=/home/vulture/vulture-server/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
